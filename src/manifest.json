{
  "manifest_version": 3,
  "name": "Background Basic",
  "version": "1.0.0",
  "description": "A Chrome extension demonstrating background service worker - hello world for background scripts",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Background Basic"
  }
}
